{
  "name": "@steycr/dsh-rewind",
  "version": "2.4.2",
  "description": "Rewind a DSH conversation to any user message: mute the abandoned branch in the chat view, exclude it from model context, keep the durable log intact, and cancel before sending.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": "0.2.0-rc.2",
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "rewind",
    "conversation"
  ],
  "author": "XSJUSTC",
  "contributors": [
    "steycr"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steycr/dsh-rewind.git"
  },
  "homepage": "https://github.com/steycr/dsh-rewind#readme",
  "bugs": "https://github.com/steycr/dsh-rewind/issues",
  "files": [
    "lib",
    "cordis.patch.yml",
    "screenshot.png",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ]
}
